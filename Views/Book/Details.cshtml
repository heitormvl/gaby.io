@model Gaby.io.ViewModels.BookDetailsViewModel
@{
    ViewData["Title"] = "Detalhes do Livro";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h1 class="display-5 fw-bold text-primary">
                        <i class="fas fa-book me-2"></i>Detalhes do Livro
                    </h1>
                    <p class="lead text-muted">Informações completas sobre o livro</p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                        <i class="fas fa-arrow-left me-2"></i>Voltar
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Informações do Livro -->
    <div class="row mb-4">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle me-2"></i>Dados do Livro
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-12 col-md-6">
                            <div class="d-flex align-items-start">
                                <div class="flex-shrink-0">
                                    <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                                        <i class="fas fa-book fa-lg text-primary"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="text-muted mb-1">Título</h6>
                                    <h4 class="mb-0 fw-bold">@Model.Title</h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="d-flex align-items-start">
                                <div class="flex-shrink-0">
                                    <div class="rounded-circle bg-info bg-opacity-10 p-3">
                                        <i class="fas fa-user-edit fa-lg text-info"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="text-muted mb-1">Autor</h6>
                                    <h4 class="mb-0">@Model.AuthorName</h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="d-flex align-items-start">
                                <div class="flex-shrink-0">
                                    <div class="rounded-circle bg-secondary bg-opacity-10 p-3">
                                        <i class="fas fa-tags fa-lg text-secondary"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="text-muted mb-1">Gêneros</h6>
                                    <h4 class="mb-0">
                                        @if (Model.GenreNames != null && Model.GenreNames.Any())
                                        {
                                            @foreach (var genre in Model.GenreNames)
                                            {
                                                <span class="badge bg-secondary fs-6 me-1 mb-1">@genre</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted"><em>—</em></span>
                                        }
                                    </h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="d-flex align-items-start">
                                <div class="flex-shrink-0">
                                    <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                                        <i class="fas fa-building fa-lg text-primary"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="text-muted mb-1">Editora</h6>
                                    <h4 class="mb-0">
                                        @if (!string.IsNullOrEmpty(Model.PublisherName))
                                        {
                                            @Model.PublisherName
                                        }
                                        else
                                        {
                                            <span class="text-muted"><em>—</em></span>
                                        }
                                    </h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="d-flex align-items-start">
                                <div class="flex-shrink-0">
                                    <div class="rounded-circle bg-success bg-opacity-10 p-3">
                                        <i class="fas fa-file-alt fa-lg text-success"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="text-muted mb-1">Páginas</h6>
                                    <h4 class="mb-0 fw-bold">@Model.PageCount</h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="d-flex align-items-start">
                                <div class="flex-shrink-0">
                                    <div class="rounded-circle bg-warning bg-opacity-10 p-3">
                                        <i class="fas fa-calendar-alt fa-lg text-warning"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="text-muted mb-1">Data de Publicação</h6>
                                    <h4 class="mb-0">
                                        @if (Model.PublicationDate.HasValue)
                                        {
                                            @Model.PublicationDate.Value.ToString("dd/MM/yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted"><em>—</em></span>
                                        }
                                    </h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="d-flex align-items-start">
                                <div class="flex-shrink-0">
                                    <div class="rounded-circle bg-warning bg-opacity-10 p-3">
                                        <i class="fas fa-star fa-lg text-warning"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="text-muted mb-1">Avaliação Média</h6>
                                    <h4 class="mb-0">
                                        @if (Model.AverageRating.HasValue)
                                        {
                                            <span class="text-warning">
                                                @{
                                                    decimal rating = Model.AverageRating.Value;
                                                    double ratingDouble = (double)rating;
                                                }
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    if (i <= Math.Floor(ratingDouble))
                                                    {
                                                        <i class="fas fa-star"></i>
                                                    }
                                                    else if (i - 0.5 <= ratingDouble)
                                                    {
                                                        <i class="fas fa-star-half-alt"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="far fa-star"></i>
                                                    }
                                                }
                                                <span class="ms-2 text-dark">@rating.ToString("0.0")</span>
                                            </span>
                                            <br>
                                            <small class="text-muted">(@Model.TotalRatings avaliação@(Model.TotalRatings != 1 ? "ões" : ""))</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted"><em>Sem avaliações</em></span>
                                        }
                                    </h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ações -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0"><i class="fas fa-cog me-2"></i>Ações</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-3">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-lg">
                            <i class="fas fa-edit me-2"></i>Editar Livro
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-lg">
                            <i class="fas fa-trash me-2"></i>Excluir Livro
                        </a>
                        <hr class="my-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-list me-2"></i>Ver Todos os Livros
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

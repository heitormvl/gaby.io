@model Gaby.io.ViewModels.BookFormViewModel
@{
    ViewData["Title"] = "Adicionar Livro";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h1 class="display-5 fw-bold text-primary">
                        <i class="fas fa-plus-circle me-2"></i>Adicionar Livro
                    </h1>
                    <p class="lead text-muted">Cadastrar um novo livro no sistema</p>
                </div>
                <div>
                    <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                        <i class="fas fa-arrow-left me-2"></i>Voltar
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Formulário -->
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0"><i class="fas fa-file-alt me-2"></i>Dados do Livro</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i><strong>Atenção!</strong> Corrija os erros abaixo.
                        </div>

                        <!-- Título -->
                        <div class="mb-4">
                            <label asp-for="Title" class="form-label fw-semibold">
                                <i class="fas fa-book text-primary me-2"></i>Título do Livro
                            </label>
                            <input asp-for="Title" class="form-control form-control-lg" placeholder="Título do livro" autofocus />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <!-- Autor -->
                        <div class="mb-4">
                            <label asp-for="AuthorId" class="form-label fw-semibold">
                                <i class="fas fa-user-edit text-info me-2"></i>Autor
                            </label>
                            <div class="input-group">
                                <select asp-for="AuthorId" asp-items="Model.Authors" class="form-select form-select-lg" id="authorSelect">
                                    <option value="">-- Selecione um autor --</option>
                                </select>
                                <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#authorModal" title="Adicionar novo autor">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>
                            <span asp-validation-for="AuthorId" class="text-danger"></span>
                        </div>

                        <!-- Editora -->
                        <div class="mb-4">
                            <label asp-for="PublisherId" class="form-label fw-semibold">
                                <i class="fas fa-building text-secondary me-2"></i>Editora (opcional)
                            </label>
                            <div class="input-group">
                                <select asp-for="PublisherId" asp-items="Model.Publishers" class="form-select form-select-lg" id="publisherSelect">
                                    <option value="">-- Selecione uma editora --</option>
                                </select>
                                <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#publisherModal" title="Adicionar nova editora">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>
                            <span asp-validation-for="PublisherId" class="text-danger"></span>
                        </div>

                        <!-- Gêneros -->
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-semibold mb-0">
                                    <i class="fas fa-tags text-secondary me-2"></i>Gêneros (opcional)
                                </label>
                                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#genreModal" title="Adicionar novo gênero">
                                    <i class="fas fa-plus me-1"></i>Novo Gênero
                                </button>
                            </div>
                            <div class="border rounded p-3" id="genresContainer" style="max-height: 200px; overflow-y: auto;">
                                @if (Model.Genres != null && Model.Genres.Any())
                                {
                                    @foreach (var genre in Model.Genres)
                                    {
                                        <div class="form-check mb-2">
                                            <input class="form-check-input" 
                                                   type="checkbox" 
                                                   name="GenreIds" 
                                                   value="@genre.Value" 
                                                   id="genre_@genre.Value"
                                                   @(Model.GenreIds != null && Model.GenreIds.Contains(int.Parse(genre.Value)) ? "checked" : "") />
                                            <label class="form-check-label" for="genre_@genre.Value">
                                                @genre.Text
                                            </label>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="text-muted mb-0">Nenhum gênero cadastrado</p>
                                }
                            </div>
                            <small class="text-muted">
                                <i class="fas fa-info-circle me-1"></i>Você pode selecionar múltiplos gêneros
                            </small>
                        </div>

                        <!-- Páginas -->
                        <div class="mb-4">
                            <label asp-for="PageCount" class="form-label fw-semibold">
                                <i class="fas fa-file-alt text-success me-2"></i>Número de Páginas
                            </label>
                            <input asp-for="PageCount" type="number" class="form-control form-control-lg" placeholder="Ex: 100" />
                            <span asp-validation-for="PageCount" class="text-danger"></span>
                        </div>

                        <!-- Data de Publicação -->
                        <div class="mb-4">
                            <label asp-for="PublicationDate" class="form-label fw-semibold">
                                <i class="fas fa-calendar-alt text-warning me-2"></i>Data de Publicação
                            </label>
                            <input asp-for="PublicationDate" type="date" class="form-control form-control-lg" />
                            <span asp-validation-for="PublicationDate" class="text-danger"></span>
                        </div>

                        <!-- Botões de Ação -->
                        <div class="row g-3 mt-4">
                            <div class="col-12 col-md-6">
                                <button type="submit" class="btn btn-primary btn-lg w-100 shadow-sm">
                                    <i class="fas fa-save me-2"></i>Salvar Livro
                                </button>
                            </div>
                            <div class="col-12 col-md-6">
                                <a asp-action="Index" class="btn btn-outline-secondary btn-lg w-100">
                                    <i class="fas fa-times me-2"></i>Cancelar
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Card de Ajuda -->
            <div class="card border-0 shadow-sm mt-4 bg-light">
                <div class="card-body">
                    <h6 class="mb-3"><i class="fas fa-lightbulb text-warning me-2"></i>Dicas</h6>
                    <ul class="mb-0 small text-muted">
                        <li class="mb-2"><i class="fas fa-check-circle text-success me-1"></i>O título deve ser único no sistema.</li>
                        <li class="mb-2"><i class="fas fa-check-circle text-success me-1"></i>Autor é obrigatório.</li>
                        <li><i class="fas fa-check-circle text-success me-1"></i>Os campos Editora e Gêneros são opcionais.</li>
                        <li><i class="fas fa-check-circle text-success me-1"></i>Você pode selecionar múltiplos gêneros para um livro.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_BookFormModals")
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    @await Html.PartialAsync("_BookFormScripts")
}
@model Gaby.io.ViewModels.CountryFormViewModel
@{
    ViewData["Title"] = "Adicionar País";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h1 class="display-5 fw-bold text-primary">
                        <i class="fas fa-plus-circle me-2"></i>Adicionar País
                    </h1>
                    <p class="lead text-muted">Cadastrar um novo país no sistema</p>
                </div>
                <div>
                    <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                        <i class="fas fa-arrow-left me-2"></i>Voltar
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Formulário -->
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0">
                        <i class="fas fa-file-alt me-2"></i>Dados do País
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>Atenção!</strong> Por favor, corrija os erros abaixo.
                        </div>

                        <!-- Nome do País -->
                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-semibold">
                                <i class="fas fa-globe text-primary me-2"></i>Nome do País
                            </label>
                            <input asp-for="Name" 
                                   class="form-control form-control-lg" 
                                   placeholder="Ex: Brasil, Estados Unidos, etc."
                                   autofocus />
                            <span asp-validation-for="Name" class="text-danger"></span>
                            <div class="form-text">
                                <i class="fas fa-info-circle me-1"></i>
                                Máximo de 50 caracteres.
                            </div>
                        </div>

                        <!-- Código ISO -->
                        <div class="mb-4">
                            <label asp-for="Code" class="form-label fw-semibold">
                                <i class="fas fa-tag text-secondary me-2"></i>Código ISO
                            </label>
                            <input asp-for="Code" 
                                   class="form-control form-control-lg text-uppercase" 
                                   placeholder="Ex: BRA, USA, GBR"
                                   maxlength="3"
                                   style="text-transform: uppercase;" />
                            <span asp-validation-for="Code" class="text-danger"></span>
                            <div class="form-text">
                                <i class="fas fa-info-circle me-1"></i>
                                Código de 2 ou 3 caracteres (ex: BR, BRA, US, USA).
                            </div>
                        </div>

                        <!-- Botões de Ação -->
                        <div class="row g-3 mt-4">
                            <div class="col-12 col-md-6">
                                <button type="submit" class="btn btn-primary btn-lg w-100 shadow-sm">
                                    <i class="fas fa-save me-2"></i>Salvar País
                                </button>
                            </div>
                            <div class="col-12 col-md-6">
                                <a asp-action="Index" class="btn btn-outline-secondary btn-lg w-100">
                                    <i class="fas fa-times me-2"></i>Cancelar
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Card de Ajuda -->
            <div class="card border-0 shadow-sm mt-4 bg-light">
                <div class="card-body">
                    <h6 class="mb-3">
                        <i class="fas fa-lightbulb text-warning me-2"></i>Dicas
                    </h6>
                    <ul class="mb-0 small text-muted">
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success me-1"></i>
                            O nome do país deve ser único no sistema.
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success me-1"></i>
                            Use códigos ISO oficiais (ISO 3166-1 alpha-2 ou alpha-3).
                        </li>
                        <li>
                            <i class="fas fa-check-circle text-success me-1"></i>
                            Todos os campos são obrigatórios.
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // Converter código para maiúsculas automaticamente
        document.querySelector('input[name="Code"]').addEventListener('input', function(e) {
            this.value = this.value.toUpperCase();
        });

        // Validação customizada em tempo real
        document.querySelector('form').addEventListener('submit', function(e) {
            const nameInput = document.querySelector('input[name="Name"]');
            const codeInput = document.querySelector('input[name="Code"]');
            
            // Remove espaços extras
            nameInput.value = nameInput.value.trim();
            codeInput.value = codeInput.value.trim().toUpperCase();
        });
    </script>
}

@model List<Gaby.io.ViewModels.PublisherListViewModel>
@{
    ViewData["Title"] = "Editoras";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h1 class="display-5 fw-bold text-primary">
                        <i class="fas fa-building me-2"></i>Editoras
                    </h1>
                    <p class="lead text-muted">Gerenciar editoras cadastradas</p>
                </div>
                <div>
                    <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
                        <i class="fas fa-plus-circle me-2"></i>Adicionar Editora
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Card de Resumo -->
    <div class="row mb-4">
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                                <i class="fas fa-building fa-2x text-primary"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="text-muted mb-1">Total de Editoras</h6>
                            <h3 class="mb-0 fw-bold">@Model.Count</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="rounded-circle bg-success bg-opacity-10 p-3">
                                <i class="fas fa-book fa-2x text-success"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="text-muted mb-1">Total de Livros</h6>
                            <h3 class="mb-0 fw-bold">@Model.Sum(p => p.BookCount)</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabela de Editoras - Desktop -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm d-none d-md-block">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0">
                        <i class="fas fa-list me-2"></i>Lista de Editoras
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="px-4 py-3">Nome</th>
                                    <th class="px-4 py-3 text-center">Livros Publicados</th>
                                    <th class="px-4 py-3 text-center" style="width: 200px;">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var publisher in Model)
                                {
                                    <tr>
                                        <td class="px-4 py-3">
                                            <div class="d-flex align-items-center">
                                                <i class="fas fa-building text-primary me-2"></i>
                                                <strong>@publisher.Name</strong>
                                            </div>
                                        </td>
                                        <td class="px-4 py-3 text-center">
                                            <span class="badge bg-success">@publisher.BookCount</span>
                                        </td>
                                        <td class="px-4 py-3">
                                            <div class="btn-group d-flex gap-1" role="group">
                                                <a asp-action="Details" asp-route-id="@publisher.Id" 
                                                   class="btn btn-sm btn-outline-primary" 
                                                   title="Detalhes">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@publisher.Id" 
                                                   class="btn btn-sm btn-outline-warning" 
                                                   title="Editar">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@publisher.Id" 
                                                   class="btn btn-sm btn-outline-danger" 
                                                   title="Excluir">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Cards de Editoras - Mobile -->
            <div class="d-md-none">
                @foreach (var publisher in Model)
                {
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="card-title mb-1">
                                        <i class="fas fa-building text-primary me-2"></i>@publisher.Name
                                    </h5>
                                    <div class="d-flex gap-2 flex-wrap">
                                        <span class="badge bg-success">
                                            <i class="fas fa-book me-1"></i>@publisher.BookCount @(publisher.BookCount == 1 ? "livro" : "livros")
                                        </span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="d-grid gap-2">
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@publisher.Id" 
                                       class="btn btn-outline-primary">
                                        <i class="fas fa-eye me-1"></i>Detalhes
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@publisher.Id" 
                                       class="btn btn-outline-warning">
                                        <i class="fas fa-edit me-1"></i>Editar
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@publisher.Id" 
                                       class="btn btn-outline-danger">
                                        <i class="fas fa-trash me-1"></i>Excluir
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Mensagem quando não há editoras -->
            @if (!Model.Any())
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-building fa-4x text-muted mb-3"></i>
                        <h5 class="text-muted">Nenhuma editora cadastrada</h5>
                        <p class="text-muted">Comece adicionando uma nova editora ao sistema.</p>
                        <a asp-action="Create" class="btn btn-primary mt-3">
                            <i class="fas fa-plus-circle me-2"></i>Adicionar Primeira Editora
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

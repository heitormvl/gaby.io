@{
    ViewData["Title"] = "Painel Administrativo";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <h2>
                <i class="fas fa-tools me-2"></i>Painel Administrativo
            </h2>
            <p class="text-muted">Bem-vindo ao painel de administração do sistema</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-users-cog fa-3x text-primary"></i>
                    </div>
                    <h5 class="card-title">Gerenciar Usuários</h5>
                    <p class="card-text text-muted">
                        Gerencie os usuários do sistema e atribua papéis de administrador
                    </p>
                    <a asp-action="Users" class="btn btn-primary">
                        <i class="fas fa-arrow-right me-2"></i>Acessar
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-chart-line fa-3x text-success"></i>
                    </div>
                    <h5 class="card-title">Estatísticas</h5>
                    <p class="card-text text-muted">
                        Visualize estatísticas e métricas do sistema
                    </p>
                    <button class="btn btn-secondary" disabled>
                        <i class="fas fa-lock me-2"></i>Em breve
                    </button>
                </div>
            </div>
        </div>
    </div>

    <h3 class="mt-5 mb-4">
        <i class="fas fa-cog me-2"></i>Configurações
    </h3>

    <div class="row">
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-flag fa-3x text-warning"></i>
                    </div>
                    <h5 class="card-title">Países</h5>
                    <p class="card-text text-muted">
                        Gerencie os países cadastrados no sistema
                    </p>
                    <a asp-area="" asp-controller="Country" asp-action="Index" class="btn btn-warning">
                        <i class="fas fa-arrow-right me-2"></i>Acessar
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-building fa-3x text-info"></i>
                    </div>
                    <h5 class="card-title">Editoras</h5>
                    <p class="card-text text-muted">
                        Gerencie as editoras cadastradas no sistema
                    </p>
                    <a asp-area="" asp-controller="Publisher" asp-action="Index" class="btn btn-info">
                        <i class="fas fa-arrow-right me-2"></i>Acessar
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-tags fa-3x text-danger"></i>
                    </div>
                    <h5 class="card-title">Gêneros</h5>
                    <p class="card-text text-muted">
                        Gerencie os gêneros de livros do sistema
                    </p>
                    <a asp-area="" asp-controller="Genre" asp-action="Index" class="btn btn-danger">
                        <i class="fas fa-arrow-right me-2"></i>Acessar
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-info mt-4" role="alert">
        <i class="fas fa-info-circle me-2"></i>
        <strong>Acesso Restrito:</strong> Apenas administradores podem acessar esta área.
    </div>
</div>

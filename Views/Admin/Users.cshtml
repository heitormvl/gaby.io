@model IEnumerable<Gaby.io.ViewModels.UserManagementViewModel>

@{
    ViewData["Title"] = "Gerenciamento de Usuários";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <h2>
                <i class="fas fa-users-cog me-2"></i>Gerenciamento de Usuários
            </h2>
            <p class="text-muted">Gerencie os papéis de administrador dos usuários do sistema</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Nome</th>
                                <th>E-mail</th>
                                <th>Status</th>
                                <th class="text-end">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>
                                        <i class="fas fa-user me-2"></i>@user.DisplayName
                                    </td>
                                    <td>@user.Email</td>
                                    <td>
                                        @if (user.IsAdmin)
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-crown me-1"></i>Administrador
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="fas fa-user me-1"></i>Usuário
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <form asp-action="ToggleAdmin" method="post" style="display: inline;" 
                                              onsubmit="return confirm('@(user.IsAdmin ? "Remover papel de administrador de" : "Conceder papel de administrador para") @user.DisplayName?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            @if (user.IsAdmin)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="fas fa-user-minus me-1"></i>Remover Admin
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success">
                                                    <i class="fas fa-user-shield me-1"></i>Tornar Admin
                                                </button>
                                            }
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-users fa-3x text-muted mb-3"></i>
                    <p class="text-muted">Nenhum usuário encontrado no sistema.</p>
                </div>
            }
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-2"></i>Voltar ao Painel Admin
        </a>
    </div>
</div>

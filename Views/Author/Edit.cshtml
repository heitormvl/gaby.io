@model Gaby.io.ViewModels.AuthorFormViewModel
@{
    ViewData["Title"] = "Editar Autor";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h1 class="display-5 fw-bold text-warning">
                        <i class="fas fa-edit me-2"></i>Editar Autor
                    </h1>
                    <p class="lead text-muted">Atualizar informações do autor</p>
                </div>
                <div>
                    <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                        <i class="fas fa-arrow-left me-2"></i>Voltar
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Formulário -->
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0">
                        <i class="fas fa-file-alt me-2"></i>Dados do Autor
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>Atenção!</strong> Por favor, corrija os erros abaixo.
                        </div>

                        <!-- Nome do Autor -->
                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-semibold">
                                <i class="fas fa-user-circle text-primary me-2"></i>Nome do Autor
                            </label>
                            <input asp-for="Name" 
                                   class="form-control form-control-lg" 
                                   placeholder="Ex: Machado de Assis, J.K. Rowling, etc."
                                   autofocus />
                            <span asp-validation-for="Name" class="text-danger"></span>
                            <div class="form-text">
                                <i class="fas fa-info-circle me-1"></i>
                                Máximo de 100 caracteres.
                            </div>
                        </div>

                        <!-- Gênero -->
                        <div class="mb-4">
                            <label asp-for="Gender" class="form-label fw-semibold">
                                <i class="fas fa-venus-mars text-info me-2"></i>Gênero
                            </label>
                            <div class="btn-group w-100" role="group">
                                <input type="radio" class="btn-check" name="Gender" id="genderM" value="M" 
                                       @(Model.Gender == 'M' ? "checked" : "") autocomplete="off">
                                <label class="btn btn-outline-primary" for="genderM">
                                    <i class="fas fa-mars me-1"></i>Masculino
                                </label>

                                <input type="radio" class="btn-check" name="Gender" id="genderF" value="F" 
                                       @(Model.Gender == 'F' ? "checked" : "") autocomplete="off">
                                <label class="btn btn-outline-primary" for="genderF">
                                    <i class="fas fa-venus me-1"></i>Feminino
                                </label>

                                <input type="radio" class="btn-check" name="Gender" id="genderN" value="N" 
                                       @(Model.Gender == 'N' ? "checked" : "") autocomplete="off">
                                <label class="btn btn-outline-primary" for="genderN">
                                    <i class="fas fa-genderless me-1"></i>Não-binário
                                </label>
                            </div>
                            <span asp-validation-for="Gender" class="text-danger"></span>
                            <div class="form-text">
                                <i class="fas fa-info-circle me-1"></i>
                                Selecione o gênero do autor.
                            </div>
                        </div>

                        <!-- País de Origem -->
                        <div class="mb-4">
                            <label asp-for="CountryId" class="form-label fw-semibold">
                                <i class="fas fa-flag text-secondary me-2"></i>País de Origem
                            </label>
                            <select asp-for="CountryId" asp-items="Model.Countries" class="form-select form-select-lg">
                                <option value="">-- Selecione um país (opcional) --</option>
                            </select>
                            <span asp-validation-for="CountryId" class="text-danger"></span>
                            <div class="form-text">
                                <i class="fas fa-info-circle me-1"></i>
                                Campo opcional. Selecione o país de origem do autor.
                            </div>
                        </div>

                        <!-- Botões de Ação -->
                        <div class="row g-3 mt-4">
                            <div class="col-12 col-md-6">
                                <button type="submit" class="btn btn-warning btn-lg w-100 shadow-sm">
                                    <i class="fas fa-save me-2"></i>Atualizar Autor
                                </button>
                            </div>
                            <div class="col-12 col-md-6">
                                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-lg w-100">
                                    <i class="fas fa-times me-2"></i>Cancelar
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Card de Ajuda -->
            <div class="card border-0 shadow-sm mt-4 bg-light">
                <div class="card-body">
                    <h6 class="mb-3">
                        <i class="fas fa-lightbulb text-warning me-2"></i>Dicas
                    </h6>
                    <ul class="mb-0 small text-muted">
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success me-1"></i>
                            Certifique-se de que o nome do autor seja único no sistema.
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success me-1"></i>
                            O campo de gênero é obrigatório.
                        </li>
                        <li>
                            <i class="fas fa-check-circle text-success me-1"></i>
                            O país de origem é opcional e pode ser deixado em branco.
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // Validação customizada em tempo real
        document.querySelector('form').addEventListener('submit', function(e) {
            const nameInput = document.querySelector('input[name="Name"]');
            
            // Remove espaços extras
            nameInput.value = nameInput.value.trim();
            
            // Valida se um gênero foi selecionado
            const genderSelected = document.querySelector('input[name="Gender"]:checked');
            if (!genderSelected) {
                e.preventDefault();
                alert('Por favor, selecione o gênero do autor.');
                return false;
            }
        });
    </script>
}

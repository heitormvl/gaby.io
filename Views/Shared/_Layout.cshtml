@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gaby.io</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/gaby.io.styles.css" asp-append-version="true" />
    <script src="https://kit.fontawesome.com/aeecc34f9e.js" crossorigin="anonymous"></script>
    <script src="https://cdn.plot.ly/plotly-3.1.0.min.js"></script>
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#5b21b6">
    <link rel="apple-touch-icon" href="/icons/icon-192x192.png">
</head>
<body class="@(isAuthenticated ? "has-mobile-tabbar" : "")">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand text-white" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-book-reader me-2"></i>Gaby.io
                </a>
                <button class="navbar-toggler @(isAuthenticated ? "mobile-hide-when-authed" : "")" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between @(isAuthenticated ? "mobile-hide-when-authed" : "")">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home me-1"></i>Início
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="Author" asp-action="Index">
                                    <i class="fas fa-pen-fancy me-1"></i>Autores
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="Book" asp-action="Index">
                                    <i class="fas fa-book me-1"></i>Livros
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="Reading" asp-action="Index">
                                    <i class="fas fa-bookmark me-1"></i>Leituras
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="Reading" asp-action="Wishlist">
                                    <i class="fas fa-heart me-1"></i>Lista de Desejos
                                </a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-area="" asp-controller="Admin" asp-action="Index">
                                        <i class="fas fa-tools me-1"></i>Admin
                                    </a>
                                </li>
                            }
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-user-circle me-1"></i>@User.FindFirst("DisplayName")?.Value
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Index">
                                            <i class="fas fa-user-circle me-2"></i>Minha Conta
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" style="display: inline;">
                                            <button type="submit" class="dropdown-item" style="border: none; background: none; cursor: pointer;">
                                                <i class="fas fa-sign-out-alt me-2"></i>Sair
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="Account" asp-action="Login">
                                    <i class="fas fa-sign-in-alt me-1"></i>Login
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @if (isAuthenticated)
    {
        <nav class="mobile-tabbar d-sm-none" aria-label="Navegação principal">
            <a class="mobile-tabbar-item @(currentController == "Home" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="fas fa-home"></i>
                <span>Início</span>
            </a>
            <a class="mobile-tabbar-item @(currentController == "Book" ? "active" : "")" asp-area="" asp-controller="Book" asp-action="Index">
                <i class="fas fa-book"></i>
                <span>Livros</span>
            </a>
            <a class="mobile-tabbar-item @(currentController == "Reading" && currentAction != "Wishlist" ? "active" : "")" asp-area="" asp-controller="Reading" asp-action="Index">
                <i class="fas fa-bookmark"></i>
                <span>Leituras</span>
            </a>
            <a class="mobile-tabbar-item @(currentAction == "Wishlist" ? "active" : "")" asp-area="" asp-controller="Reading" asp-action="Wishlist">
                <i class="fas fa-heart"></i>
                <span>Desejos</span>
            </a>
            <button type="button" class="mobile-tabbar-item @(currentController is "Author" or "Account" or "Admin" ? "active" : "")" data-bs-toggle="offcanvas" data-bs-target="#mobileMoreSheet" aria-controls="mobileMoreSheet">
                <i class="fas fa-ellipsis-h"></i>
                <span>Mais</span>
            </button>
        </nav>

        <div class="offcanvas offcanvas-bottom mobile-more-sheet d-sm-none" tabindex="-1" id="mobileMoreSheet" aria-labelledby="mobileMoreSheetLabel">
            <div class="offcanvas-header">
                <h5 class="offcanvas-title" id="mobileMoreSheetLabel">Mais</h5>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body">
                <a class="mobile-more-link" asp-area="" asp-controller="Author" asp-action="Index">
                    <i class="fas fa-pen-fancy"></i> Autores
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a class="mobile-more-link" asp-area="" asp-controller="Admin" asp-action="Index">
                        <i class="fas fa-tools"></i> Admin
                    </a>
                }
                <a class="mobile-more-link" asp-area="" asp-controller="Account" asp-action="Index">
                    <i class="fas fa-user-circle"></i> Minha Conta
                </a>
                <hr />
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="mobile-more-link mobile-more-link-danger">
                        <i class="fas fa-sign-out-alt"></i> Sair
                    </button>
                </form>
            </div>
        </div>
    }

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer bg-dark text-white">
        <div class="container text-center">
            &copy; 2025 - Gaby.io
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        if ("serviceWorker" in navigator) {
            window.addEventListener("load", () => {
                navigator.serviceWorker.register("/service-worker.js")
                    .then(reg => console.log("Service Worker registrado:", reg.scope))
                    .catch(err => console.error("Erro ao registrar SW:", err));
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model List<Gaby.io.ViewModels.ReadingListViewModel>
@{
    ViewData["Title"] = "Minhas Leituras";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h1 class="display-5 fw-bold text-primary">
                        <i class="fas fa-book-reader me-2"></i>Minhas Leituras
                    </h1>
                    <p class="lead text-muted">Acompanhe seus registros de leitura</p>
                </div>
                <div>
                    <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
                        <i class="fas fa-plus-circle me-2"></i>Adicionar Leitura
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Cards de Resumo -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                                <i class="fas fa-book-reader fa-2x text-primary"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="text-muted mb-1">Total de Leituras</h6>
                            <h3 class="mb-0 fw-bold">@Model.Count</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="rounded-circle bg-success bg-opacity-10 p-3">
                                <i class="fas fa-check-circle fa-2x text-success"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h6 class="text-muted mb-1">Leituras Concluídas</h6>
                            <h3 class="mb-0 fw-bold">@Model.Count(r => r.Status == "Concluída")</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabela de Leituras - Desktop -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm d-none d-sm-block">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0"><i class="fas fa-list me-2"></i>Histórico de Leituras</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="px-4 py-3">Livro</th>
                                    <th class="px-4 py-3">Data de Início</th>
                                    <th class="px-4 py-3">Data de Término</th>
                                    <th class="px-4 py-3 text-center">Status</th>
                                    <th class="px-4 py-3 text-center" style="width: 200px;">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var reading in Model)
                                {
                                    <tr>
                                        <td class="px-4 py-3">
                                            <div class="d-flex align-items-center">
                                                <i class="fas fa-book text-primary me-2"></i>
                                                <strong>@reading.BookTitle</strong>
                                            </div>
                                        </td>
                                        <td class="px-4 py-3">@reading.StartDate.ToString("dd/MM/yyyy")</td>
                                        <td class="px-4 py-3">
                                            @if (reading.EndDate.HasValue)
                                            {
                                                @reading.EndDate.Value.ToString("dd/MM/yyyy")
                                            }
                                            else
                                            {
                                                <span class="text-muted"><em>—</em></span>
                                            }
                                        </td>
                                        <td class="px-4 py-3 text-center">
                                            @if (reading.Status == "Concluída")
                                            {
                                                <span class="badge bg-success">
                                                    <i class="fas fa-check-circle me-1"></i>@reading.Status
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">
                                                    <i class="fas fa-hourglass-half me-1"></i>@reading.Status
                                                </span>
                                            }
                                        </td>
                                        <td class="px-4 py-3">
                                            <div class="btn-group d-flex gap-1" role="group">
                                                <a asp-action="Details" asp-route-id="@reading.Id" class="btn btn-sm btn-outline-primary" title="Detalhes">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@reading.Id" class="btn btn-sm btn-outline-warning" title="Editar">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@reading.Id" class="btn btn-sm btn-outline-danger" title="Excluir">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Lista de Leituras - Mobile (estilo iOS, deslize para excluir) -->
            <div class="ios-list d-sm-none" data-swipe-container>
                @foreach (var reading in Model)
                {
                    var subtitle = "Início: " + reading.StartDate.ToString("dd/MM/yyyy") + " · " + reading.Status;
                    <div class="ios-list-row" data-swipeable>
                        <div class="ios-list-row-actions">
                            <a asp-action="Delete" asp-route-id="@reading.Id" class="ios-swipe-delete-btn">Excluir</a>
                        </div>
                        <a asp-action="Details" asp-route-id="@reading.Id" class="ios-list-row-content">
                            <div class="ios-list-row-icon">
                                <i class="fas fa-book-reader"></i>
                            </div>
                            <div class="ios-list-row-text">
                                <div class="ios-list-row-title">@reading.BookTitle</div>
                                <div class="ios-list-row-subtitle">@subtitle</div>
                            </div>
                            <i class="fas fa-chevron-right ios-list-row-chevron"></i>
                        </a>
                    </div>
                }
            </div>

            <!-- Mensagem quando não há leituras -->
            @if (!Model.Any())
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-book-reader fa-4x text-muted mb-3"></i>
                        <h5 class="text-muted">Nenhuma leitura cadastrada</h5>
                        <p class="text-muted">Comece registrando um livro que está lendo.</p>
                        <a asp-action="Create" class="btn btn-primary mt-3">
                            <i class="fas fa-plus-circle me-2"></i>Registrar Primeira Leitura
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@model Gaby.io.ViewModels.ReadingFormViewModel
@{
    ViewData["Title"] = "Adicionar Leitura";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h1 class="display-5 fw-bold text-primary">
                        <i class="fas fa-plus-circle me-2"></i>Registrar Leitura
                    </h1>
                    <p class="lead text-muted">Cadastrar um novo registro de leitura</p>
                </div>
                <div>
                    <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                        <i class="fas fa-arrow-left me-2"></i>Voltar
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Formulário -->
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0"><i class="fas fa-file-alt me-2"></i>Dados da Leitura</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i><strong>Atenção!</strong> Corrija os erros abaixo.
                        </div>

                        <!-- Livro -->
                        <div class="mb-4">
                            <label asp-for="BookId" class="form-label fw-semibold">
                                <i class="fas fa-book text-primary me-2"></i>Selecione um Livro
                            </label>
                            <select asp-for="BookId" asp-items="Model.Books" class="form-select form-select-lg">
                                <option value="">-- Selecione um livro --</option>
                            </select>
                            <span asp-validation-for="BookId" class="text-danger"></span>
                        </div>

                        <!-- Data de Início -->
                        <div class="mb-4">
                            <label asp-for="StartDate" class="form-label fw-semibold">
                                <i class="fas fa-calendar-alt text-info me-2"></i>Data de Início
                            </label>
                            <input asp-for="StartDate" type="date" class="form-control form-control-lg" />
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                        </div>

                        <!-- Data de Término -->
                        <div class="mb-4">
                            <label asp-for="EndDate" class="form-label fw-semibold">
                                <i class="fas fa-calendar-check text-success me-2"></i>Data de Término (opcional)
                            </label>
                            <input asp-for="EndDate" type="date" class="form-control form-control-lg" />
                            <span asp-validation-for="EndDate" class="text-danger"></span>
                        </div>

                        <!-- Status -->
                        <div class="mb-4">
                            <label asp-for="Status" class="form-label fw-semibold">
                                <i class="fas fa-check-circle text-success me-2"></i>Status da Leitura
                            </label>
                            <div class="btn-group w-100" role="group">
                                <input type="radio" class="btn-check" name="Status" id="statusProgress" value="Em progresso" autocomplete="off" checked>
                                <label class="btn btn-outline-warning" for="statusProgress">
                                    <i class="fas fa-hourglass-half me-1"></i>Em Progresso
                                </label>

                                <input type="radio" class="btn-check" name="Status" id="statusCompleted" value="Concluída" autocomplete="off">
                                <label class="btn btn-outline-success" for="statusCompleted">
                                    <i class="fas fa-check-circle me-1"></i>Concluída
                                </label>
                            </div>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>

                        <!-- Páginas Lidas -->
                        <div class="mb-4">
                            <label asp-for="PagesRead" class="form-label fw-semibold">
                                <i class="fas fa-file-alt text-secondary me-2"></i>Páginas Lidas
                            </label>
                            <input asp-for="PagesRead" type="number" class="form-control form-control-lg" placeholder="Ex: 250" />
                            <span asp-validation-for="PagesRead" class="text-danger"></span>
                        </div>

                        <!-- Botões de Ação -->
                        <div class="row g-3 mt-4">
                            <div class="col-12 col-md-6">
                                <button type="submit" class="btn btn-primary btn-lg w-100 shadow-sm">
                                    <i class="fas fa-save me-2"></i>Salvar Leitura
                                </button>
                            </div>
                            <div class="col-12 col-md-6">
                                <a asp-action="Index" class="btn btn-outline-secondary btn-lg w-100">
                                    <i class="fas fa-times me-2"></i>Cancelar
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Card de Ajuda -->
            <div class="card border-0 shadow-sm mt-4 bg-light">
                <div class="card-body">
                    <h6 class="mb-3"><i class="fas fa-lightbulb text-warning me-2"></i>Dicas</h6>
                    <ul class="mb-0 small text-muted">
                        <li class="mb-2"><i class="fas fa-check-circle text-success me-1"></i>Selecione o livro que deseja registrar.</li>
                        <li class="mb-2"><i class="fas fa-check-circle text-success me-1"></i>Informe as datas de início e fim da leitura.</li>
                        <li><i class="fas fa-check-circle text-success me-1"></i>Indique o status e a quantidade de páginas lidas.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

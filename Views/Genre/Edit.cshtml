@model Gaby.io.ViewModels.GenreFormViewModel
@{
    ViewData["Title"] = "Editar Gênero";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h1 class="display-5 fw-bold text-warning">
                        <i class="fas fa-edit me-2"></i>Editar Gênero
                    </h1>
                    <p class="lead text-muted">Atualizar informações do gênero literário</p>
                </div>
                <div>
                    <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                        <i class="fas fa-arrow-left me-2"></i>Voltar
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Formulário -->
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0">
                        <i class="fas fa-file-alt me-2"></i>Dados do Gênero
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>Atenção!</strong> Por favor, corrija os erros abaixo.
                        </div>

                        <div class="ios-form-list">
                        <!-- Nome do Gênero -->
                        <div class="ios-form-row form-field-group">
                            <label asp-for="Name" class="form-label fw-semibold">
                                <i class="fas fa-bookmark text-primary me-2"></i>Nome do Gênero
                            </label>
                            <input asp-for="Name"
                                   class="form-control form-control-lg"
                                   placeholder="Ex: Ficção Científica, Romance, Terror, etc."
                                   autofocus />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        </div>

                        <!-- Botões de Ação -->
                        <div class="row g-3 mt-4">
                            <div class="col-12 col-md-6">
                                <button type="submit" class="btn btn-warning btn-lg w-100 shadow-sm">
                                    <i class="fas fa-save me-2"></i>Atualizar Gênero
                                </button>
                            </div>
                            <div class="col-12 col-md-6">
                                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-lg w-100">
                                    <i class="fas fa-times me-2"></i>Cancelar
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Card de Ajuda -->
            <div class="card border-0 shadow-sm mt-4 bg-light">
                <div class="card-body">
                    <h6 class="mb-3">
                        <i class="fas fa-lightbulb text-warning me-2"></i>Dicas
                    </h6>
                    <ul class="mb-0 small text-muted">
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success me-1"></i>
                            Certifique-se de que o nome do gênero seja único no sistema.
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success me-1"></i>
                            Evite abreviações para facilitar a busca e organização.
                        </li>
                        <li>
                            <i class="fas fa-check-circle text-success me-1"></i>
                            As alterações afetarão todos os livros associados a este gênero.
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // Validação customizada em tempo real
        document.querySelector('form').addEventListener('submit', function(e) {
            const nameInput = document.querySelector('input[name="Name"]');
            
            // Remove espaços extras
            nameInput.value = nameInput.value.trim();
            
            // Valida se o campo não está vazio
            if (nameInput.value.length === 0) {
                e.preventDefault();
                alert('Por favor, informe o nome do gênero.');
                nameInput.focus();
                return false;
            }
        });
    </script>
}

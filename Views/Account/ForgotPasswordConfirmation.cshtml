@{
    ViewData["Title"] = "Verifique seu e-mail";
}

<div class="container-fluid">
    <div class="row justify-content-center min-vh-100 align-items-center">
        <div class="col-12 col-md-6 col-lg-5">
            <div class="text-center mb-5">
                <h1 class="display-6 fw-bold text-primary mb-2">
                    <i class="fas fa-book me-2"></i>Gaby.io
                </h1>
            </div>

            <div class="card border-0 shadow-lg">
                <div class="card-body p-5 text-center">
                    <i class="fas fa-envelope-open-text text-primary mb-4" style="font-size: 3rem;"></i>
                    <h4 class="fw-bold mb-3">Verifique seu e-mail</h4>
                    <p class="text-muted mb-4">
                        Se houver uma conta associada a esse e-mail, enviamos um link para você redefinir sua senha.
                        Confira também a caixa de spam.
                    </p>
                    <a asp-action="Login" class="btn btn-primary btn-lg w-100 shadow-sm fw-bold">
                        <i class="fas fa-sign-in-alt me-2"></i>Voltar ao login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

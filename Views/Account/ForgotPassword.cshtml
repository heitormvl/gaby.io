@model Gaby.io.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Esqueci minha senha";
}

<div class="container-fluid">
    <div class="row justify-content-center min-vh-100 align-items-center">
        <div class="col-12 col-md-6 col-lg-5">
            <!-- Logo/Título -->
            <div class="text-center mb-5">
                <h1 class="display-6 fw-bold text-primary mb-2">
                    <i class="fas fa-book me-2"></i>Gaby.io
                </h1>
                <p class="lead text-muted">Recupere o acesso à sua conta</p>
            </div>

            <!-- Card de Recuperação -->
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-primary text-white border-0 py-4">
                    <h4 class="mb-0 text-center fw-bold">
                        <i class="fas fa-key me-2"></i>Esqueci Minha Senha
                    </h4>
                </div>
                <div class="card-body p-5">
                    <p class="text-muted mb-4">Informe o e-mail cadastrado e enviaremos um link para você redefinir sua senha.</p>

                    <form asp-action="ForgotPassword" method="post">
                        <!-- Erros Gerais -->
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>Erro:</strong>
                        </div>

                        <div class="ios-form-list">
                            <!-- Email -->
                            <div class="ios-form-row form-field-group">
                                <label asp-for="Email" class="form-label fw-semibold">
                                    <i class="fas fa-envelope text-info me-2"></i>E-mail
                                </label>
                                <input asp-for="Email"
                                       type="email"
                                       class="form-control form-control-lg"
                                       placeholder="seu@email.com"
                                       autofocus />
                                <span asp-validation-for="Email" class="invalid-feedback d-block"></span>
                            </div>
                        </div>

                        <!-- Botão de Envio -->
                        <button type="submit" class="btn btn-primary btn-lg w-100 mb-3 shadow-sm fw-bold">
                            <i class="fas fa-paper-plane me-2"></i>Enviar link de redefinição
                        </button>

                        <!-- Link para Login -->
                        <div class="text-center">
                            <p class="text-muted">Lembrou sua senha?
                                <a asp-action="Login" class="text-primary fw-bold text-decoration-none">
                                    Voltar ao login
                                </a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

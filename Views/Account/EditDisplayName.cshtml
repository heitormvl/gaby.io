@model Gaby.io.ViewModels.EditDisplayNameViewModel
@{
    ViewData["Title"] = "Editar Nome";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <!-- Header -->
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div>
                        <h1 class="display-6 fw-bold text-primary">
                            <i class="fas fa-user-edit me-2"></i>Editar Nome
                        </h1>
                        <p class="lead text-muted">Atualize seu nome de exibição</p>
                    </div>
                    <div>
                        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                            <i class="fas fa-arrow-left me-2"></i>Voltar
                        </a>
                    </div>
                </div>
            </div>

            <!-- Card de Edição -->
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-primary text-white border-0 py-4">
                    <h4 class="mb-0 text-center fw-bold">
                        <i class="fas fa-id-card me-2"></i>Alterar Nome de Exibição
                    </h4>
                </div>
                <div class="card-body p-5">
                    <form asp-action="EditDisplayName" method="post">
                        <!-- Erros Gerais -->
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>Verifique os erros abaixo:</strong>
                        </div>

                        <div class="ios-form-list">
                            <!-- Nome de Exibição -->
                            <div class="ios-form-row form-field-group">
                                <label asp-for="DisplayName" class="form-label fw-semibold">
                                    <i class="fas fa-user text-primary me-2"></i>Nome de Exibição
                                </label>
                                <input asp-for="DisplayName"
                                       type="text"
                                       class="form-control form-control-lg"
                                       placeholder="Seu nome de exibição"
                                       autofocus />
                                <span asp-validation-for="DisplayName" class="invalid-feedback d-block"></span>
                            </div>
                        </div>

                        <!-- Botões -->
                        <div class="d-grid gap-3">
                            <button type="submit" class="btn btn-primary btn-lg shadow-sm fw-bold">
                                <i class="fas fa-save me-2"></i>Salvar Alterações
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="fas fa-times me-2"></i>Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Card de Informações -->
            <div class="card border-0 shadow-sm mt-4 bg-light">
                <div class="card-body">
                    <h6 class="mb-3 fw-bold">
                        <i class="fas fa-lightbulb text-warning me-2"></i>Dica
                    </h6>
                    <p class="small text-muted mb-0">
                        <i class="fas fa-check text-success me-2"></i>
                        Após salvar, seu novo nome será exibido imediatamente em toda a aplicação.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

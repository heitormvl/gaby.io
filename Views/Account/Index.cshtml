@model Gaby.io.ViewModels.AccountViewModel
@{
    ViewData["Title"] = "Minha Conta";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h1 class="display-5 fw-bold text-primary">
                        <i class="fas fa-user-circle me-2"></i>Minha Conta
                    </h1>
                    <p class="lead text-muted">Informações do perfil</p>
                </div>
                <div>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                        <i class="fas fa-arrow-left me-2"></i>Voltar
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Informações da Conta -->
    <div class="row mb-4">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0">
                        <i class="fas fa-user-circle me-2"></i>Dados da Conta
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-12 col-md-6">
                            <div class="d-flex align-items-start">
                                <div class="flex-shrink-0">
                                    <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                                        <i class="fas fa-user fa-lg text-primary"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="text-muted mb-1">Nome</h6>
                                    <h4 class="mb-0 fw-bold">@Model.Name</h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="d-flex align-items-start">
                                <div class="flex-shrink-0">
                                    <div class="rounded-circle bg-info bg-opacity-10 p-3">
                                        <i class="fas fa-envelope fa-lg text-info"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="text-muted mb-1">E-mail</h6>
                                    <h4 class="mb-0">@Model.Email</h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="d-flex align-items-start">
                                <div class="flex-shrink-0">
                                    <div class="rounded-circle bg-success bg-opacity-10 p-3">
                                        <i class="fas fa-calendar-alt fa-lg text-success"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="text-muted mb-1">Registrado em</h6>
                                    <h4 class="mb-0">@Model.RegisteredAt.ToString("dd/MM/yyyy")</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card de Ações -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0">
                        <i class="fas fa-cog me-2"></i>Ações
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-3">
                        <a asp-action="EditDisplayName" class="btn btn-primary btn-lg">
                            <i class="fas fa-user-edit me-2"></i>Editar Nome
                        </a>
                        <button type="button" class="btn btn-warning btn-lg" data-bs-toggle="modal" data-bs-target="#logoutModal">
                            <i class="fas fa-sign-out-alt me-2"></i>Sair da Conta
                        </button>
                        <hr class="my-2">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-home me-2"></i>Ir para Início
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Card de Informações -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm bg-light">
                <div class="card-body">
                    <h6 class="mb-3 fw-bold">
                        <i class="fas fa-info-circle text-info me-2"></i>Informações
                    </h6>
                    <ul class="list-unstyled small text-muted mb-0">
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>Você pode registrar e acompanhar suas leituras
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>Visualize gráficos e estatísticas de leitura
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>Gerencie seus livros, autores e editoras
                        </li>
                        <li>
                            <i class="fas fa-check text-success me-2"></i>Seus dados estão seguros e criptografados
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Logout -->
<div class="modal fade" id="logoutModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-warning text-dark border-0">
                <h5 class="modal-title fw-bold">
                    <i class="fas fa-sign-out-alt me-2"></i>Sair da Conta
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">
                    <i class="fas fa-question-circle text-warning me-2"></i>
                    Tem certeza que deseja sair de sua conta?
                </p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancelar
                </button>
                <form asp-action="Logout" method="post" style="display: inline;">
                    <button type="submit" class="btn btn-warning">
                        <i class="fas fa-sign-out-alt me-1"></i>Sair
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

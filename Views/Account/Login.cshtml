@model Gaby.io.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="container-fluid">
    <div class="row justify-content-center min-vh-100 align-items-center">
        <div class="col-12 col-md-6 col-lg-5">
            <!-- Logo/Título -->
            <div class="text-center mb-5">
                <h1 class="display-6 fw-bold text-primary mb-2">
                    <i class="fas fa-book me-2"></i>Gaby.io
                </h1>
                <p class="lead text-muted">Acesse sua conta e gerencie suas leituras</p>
            </div>

            <!-- Card de Login -->
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-primary text-white border-0 py-4">
                    <h4 class="mb-0 text-center fw-bold">
                        <i class="fas fa-sign-in-alt me-2"></i>Fazer Login
                    </h4>
                </div>
                <div class="card-body p-5">
                    <form asp-action="Login" method="post">
                        <!-- Erros Gerais -->
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>Erro de autenticação:</strong>
                        </div>

                        <div class="ios-form-list">
                            <!-- Email -->
                            <div class="ios-form-row form-field-group">
                                <label asp-for="Email" class="form-label fw-semibold">
                                    <i class="fas fa-envelope text-info me-2"></i>E-mail
                                </label>
                                <input asp-for="Email"
                                       type="email"
                                       class="form-control form-control-lg"
                                       placeholder="seu@email.com"
                                       autofocus />
                                <span asp-validation-for="Email" class="invalid-feedback d-block"></span>
                            </div>

                            <!-- Senha -->
                            <div class="ios-form-row form-field-group">
                                <label asp-for="Password" class="form-label fw-semibold">
                                    <i class="fas fa-lock text-warning me-2"></i>Senha
                                </label>
                                <div class="input-group">
                                    <input asp-for="Password"
                                           type="password"
                                           class="form-control form-control-lg"
                                           placeholder="Sua senha"
                                           id="passwordInput" />
                                    <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Password" class="invalid-feedback d-block"></span>
                            </div>

                            <!-- Lembrar Login -->
                            <div class="ios-form-row form-field-group">
                                <div class="form-check form-switch ios-genre-row">
                                    <input asp-for="RememberMe" type="checkbox" role="switch" class="form-check-input" id="rememberMe" />
                                    <label class="form-check-label" for="rememberMe">
                                        Lembrar-me
                                    </label>
                                </div>
                            </div>

                            <!-- Esqueci minha senha -->
                            <div class="text-end mb-2">
                                <a asp-action="ForgotPassword" class="text-primary text-decoration-none small">
                                    Esqueceu a senha?
                                </a>
                            </div>
                        </div>

                        <!-- Botão de Login -->
                        <button type="submit" class="btn btn-primary btn-lg w-100 mb-3 shadow-sm fw-bold">
                            <i class="fas fa-sign-in-alt me-2"></i>Entrar
                        </button>

                        <!-- Link para Registro -->
                        <div class="text-center">
                            <p class="text-muted">Não possui uma conta? 
                                <a asp-action="Register" class="text-primary fw-bold text-decoration-none">
                                    Registre-se aqui
                                </a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Card de Segurança -->
            <div class="card border-0 shadow-sm mt-4">
                <div class="card-body">
                    <h6 class="mb-3 fw-bold">
                        <i class="fas fa-shield-alt text-success me-2"></i>Segurança
                    </h6>
                    <ul class="list-unstyled small text-muted">
                        <li class="mb-2">
                            <i class="fas fa-lock text-success me-2"></i>Sua senha é criptografada
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-lock text-success me-2"></i>Dados pessoais protegidos
                        </li>
                        <li>
                            <i class="fas fa-lock text-success me-2"></i>Acesso seguro garantido
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        document.getElementById('togglePassword').addEventListener('click', function() {
            const input = document.getElementById('passwordInput');
            const icon = this.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        });
    </script>
}
